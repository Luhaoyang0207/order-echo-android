<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="#F2F2F2" android:minHeight="112dp" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/phone_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/black" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/recording_metadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" />
    <ProgressBar android:id="@+id/playback_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/playback_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/play_pause" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" />
        <Button android:id="@+id/delete_recording" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="8dp" android:text="@string/delete" />
    </LinearLayout>
</LinearLayout>
