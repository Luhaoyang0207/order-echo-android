<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retention_title"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/retention_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton android:id="@+id/retention_7" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_7" />
            <RadioButton android:id="@+id/retention_30" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_30" />
            <RadioButton android:id="@+id/retention_60" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_60" />
            <RadioButton android:id="@+id/retention_90" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_90" />
            <RadioButton android:id="@+id/retention_180" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_180" />
        </RadioGroup>

        <Button
            android:id="@+id/run_cleanup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/run_cleanup" />

        <TextView
            android:id="@+id/cleanup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
