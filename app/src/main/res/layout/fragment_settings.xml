<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/first_call_title"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/first_call_permissions_explanation" />
        <TextView
            android:id="@+id/first_call_permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <Button
            android:id="@+id/grant_call_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/grant_call_permissions" />
        <Button
            android:id="@+id/grant_overlay_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/grant_overlay_permission" />
        <TextView
            android:id="@+id/call_monitor_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <Button
            android:id="@+id/toggle_call_monitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/call_monitor_enable" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/call_monitor_explanation" />
        <LinearLayout
            android:id="@+id/first_call_diagnostics_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/test_call_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/first_call_test_overlay" />
            <Button
                android:id="@+id/start_call_probe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/first_call_probe_title" />
            <Button
                android:id="@+id/show_call_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/first_call_diagnostics_title" />
        </LinearLayout>
        <Button
            android:id="@+id/first_call_app_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/first_call_open_app_settings" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/first_call_huawei_help" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retention_title"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/retention_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton android:id="@+id/retention_7" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_7" />
            <RadioButton android:id="@+id/retention_30" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_30" />
            <RadioButton android:id="@+id/retention_60" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_60" />
            <RadioButton android:id="@+id/retention_90" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_90" />
            <RadioButton android:id="@+id/retention_180" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/retention_180" />
        </RadioGroup>

        <Button
            android:id="@+id/run_cleanup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/run_cleanup" />

        <TextView
            android:id="@+id/cleanup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
