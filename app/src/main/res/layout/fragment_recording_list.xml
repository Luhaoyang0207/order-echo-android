<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/search_number" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="@string/search_number_hint" android:inputType="phone" />
        <Button android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/refresh" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recording_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="8dp" />
</LinearLayout>
